# Database (app_user for runtime - RLS applies)
DATABASE_URL=postgresql://app_user:app_password@postgres:5432/kovia

# Database (superuser for migrations only - bypasses RLS)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kovia

# Redis
REDIS_URL=redis://redis:6379

# Mail (Mailpit in development)
MAIL_HOST=mailpit
MAIL_PORT=1025

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# App
APP_URL=http://localhost:3001

# n8n webhook endpoint (optional — leave empty to disable webhooks in dev)
N8N_WEBHOOK_URL=
