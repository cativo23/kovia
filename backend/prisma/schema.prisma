generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Force the TS generator to emit `.js` extensions in import statements.
  // With NodeNext moduleResolution Prisma defaults to `.ts` literals, which
  // SWC keeps verbatim when compiling to CommonJS — producing
  // require("./internal/class.ts") that Node can't resolve at runtime.
  // See: https://github.com/prisma/prisma/issues/25833
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADOPTER
  ORG_ADMIN
  ORG_STAFF
  PLATFORM_ADMIN
}

enum OrgStatus {
  ACTIVE
  DEACTIVATED
}

enum AnimalGender {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnimalStatus {
  AVAILABLE
  IN_PROCESS
  ADOPTED
  ARCHIVED
}

enum ApplicationStatus {
  ENVIADA
  REVISANDO
  APROBADA
  RECHAZADA
  SEGUIMIENTO
  ADOPTADA
  RETIRADA
  DEVUELTA
}

enum NotificationType {
  APPLICATION_SUBMITTED
  STATUS_CHANGED
  NOTE_ADDED
  SCORED
  WITHDRAWN
  DEVUELTA
}

enum AdoptionCategory {
  SALUDABLE_ADULTO
  SENIOR
  MEDICO_CRONICO
  REACTIVO
  ESPECIAL
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  role          UserRole @default(ADOPTER)
  emailVerified Boolean  @default(false)
  googleId      String?  @unique
  firstName     String?
  lastName      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgId String?
  org   Organization? @relation("OrgMembers", fields: [orgId], references: [id], onDelete: SetNull)

  refreshTokens   RefreshToken[]
  organization    Organization?           @relation("OrgAdmin")
  auditLogs       AuditLog[]
  applications    AdoptionApplication[]
  authoredNotes   ApplicationNote[]       @relation("NoteAuthor")
  sentTeamInvites TeamInvite[]            @relation("InvitedBy")
  acknowledgments DossierAcknowledgment[]

  @@index([orgId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  logoUrl      String?
  contactEmail String?
  phone        String?
  instagram    String?
  facebook     String?
  whatsapp     String?
  status       OrgStatus @default(ACTIVE)
  adminId      String    @unique
  admin        User      @relation("OrgAdmin", fields: [adminId], references: [id])
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  animals         Animal[]
  members         User[]                @relation("OrgMembers")
  teamInvites     TeamInvite[]
  applications    AdoptionApplication[]
  adoptionStories AdoptionStory[]

  @@map("organizations")
}

model OrgInvite {
  id         String    @id @default(uuid())
  email      String
  orgName    String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("org_invites")
}

model TeamInvite {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  token       String       @unique
  invitedById String
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([orgId, email])
  @@index([email])
  @@map("team_invites")
}

model Species {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  animals   Animal[]

  @@map("species")
}

model Animal {
  id                String       @id @default(uuid())
  name              String
  description       String?
  speciesId         String
  species           Species      @relation(fields: [speciesId], references: [id])
  breed             String?
  gender            AnimalGender @default(UNKNOWN)
  ageMonths         Int?
  size              AnimalSize?
  energyLevel       EnergyLevel?
  goodWithKids      Boolean      @default(false)
  goodWithDogs      Boolean      @default(false)
  goodWithCats      Boolean      @default(false)
  goodWithOtherPets Boolean      @default(false)
  specialNeeds      String?
  vaccinated        Boolean      @default(false)
  sterilized        Boolean      @default(false)
  trained           Boolean      @default(false)

  // Phase 15 dossier fields (per D-05)
  adoptionCategory     AdoptionCategory?
  behavioralEvaluation String?           @db.Text
  medicalHistory       String?           @db.Text
  monthlyCostUsdMin    Int?
  monthlyCostUsdMax    Int?
  knownTriggers        String[]          @default([])
  shelterEntryDate     DateTime?         @db.Date
  dossierComplete      Boolean           @default(false)
  dossierVersion       Int               @default(1)

  status          AnimalStatus            @default(AVAILABLE)
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id])
  photos          AnimalPhoto[]
  coverPhotoId    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  archivedAt      DateTime?
  applications    AdoptionApplication[]
  acknowledgments DossierAcknowledgment[]
  stories         AdoptionStory[]

  @@map("animals")
}

model AdoptionApplication {
  id                String            @id @default(uuid())
  animalId          String
  animal            Animal            @relation(fields: [animalId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  status            ApplicationStatus @default(ENVIADA)
  personalInfo      Json?
  housing           Json?
  lifestyle         Json?
  socialMedia       String?
  additionalContext String?
  adopterFirstName  String?
  adopterLastName   String?
  adopterEmail      String?
  adopterCity       String?
  score             Int?
  scoreDetails      Json?
  submittedAt       DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  photos        ApplicationPhoto[]
  notes         ApplicationNote[]
  notifications Notification[]

  // Active-application uniqueness is enforced via a PostgreSQL partial unique index
  // (migration 10_partial_unique_active_applications): UNIQUE (animalId, userId) WHERE status != 'RETIRADA'.
  // Prisma @@unique cannot express a WHERE clause, so the constraint lives in raw SQL.
  // D-14: allows resubmit after withdraw; service layer rejects duplicates in non-RETIRADA states.
  @@map("adoption_applications")
}

model ApplicationNote {
  id             String              @id @default(uuid())
  applicationId  String
  application    AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String
  authorId       String
  author         User                @relation("NoteAuthor", fields: [authorId], references: [id])
  body           String
  createdAt      DateTime            @default(now())

  @@map("application_notes")
}

model ApplicationPhoto {
  id            String              @id @default(uuid())
  applicationId String
  application   AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  url           String
  key           String
  position      Int                 @default(0)
  createdAt     DateTime            @default(now())

  @@map("application_photos")
}

model AnimalPhoto {
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String
  key       String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("animal_photos")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Notification {
  id            String               @id @default(uuid())
  userId        String // adopter who receives the notification
  type          NotificationType
  title         String // Spanish text, e.g., "Tu solicitud fue aprobada"
  body          String? // Additional context, e.g., "para Max"
  applicationId String?
  application   AdoptionApplication? @relation(fields: [applicationId], references: [id])
  isRead        Boolean              @default(false)
  createdAt     DateTime             @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model WebhookOutbox {
  id             String    @id @default(uuid())
  eventType      String // application.submitted, application.status_changed, etc.
  payload        Json // Full event payload
  idempotencyKey String    @unique
  status         String    @default("PENDING") // PENDING, DELIVERED, FAILED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(6)
  nextAttemptAt  DateTime?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@map("webhook_outbox")
}

model AdoptionStory {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  adopterFirstName String
  city             String
  testimonial      String       @db.Text
  photoUrl         String?
  animalId         String?
  animal           Animal?      @relation(fields: [animalId], references: [id], onDelete: SetNull)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([publishedAt(sort: Desc)])
  @@index([organizationId, publishedAt(sort: Desc)])
  @@map("adoption_stories")
}

model DossierAcknowledgment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  animalId       String
  animal         Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  ackedAt        DateTime @default(now())
  dossierVersion Int

  @@unique([userId, animalId])
  @@index([animalId])
  @@map("dossier_acknowledgments")
}
