generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADOPTER
  ORG_ADMIN
  PLATFORM_ADMIN
}

enum OrgStatus {
  ACTIVE
  DEACTIVATED
}

enum AnimalGender {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnimalStatus {
  AVAILABLE
  IN_PROCESS
  ADOPTED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(ADOPTER)
  emailVerified Boolean   @default(false)
  googleId      String?   @unique
  firstName     String?
  lastName      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  organization  Organization? @relation("OrgAdmin")
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  logoUrl      String?
  contactEmail String?
  phone        String?
  instagram    String?
  facebook     String?
  whatsapp     String?
  status       OrgStatus @default(ACTIVE)
  adminId      String    @unique
  admin        User      @relation("OrgAdmin", fields: [adminId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  animals      Animal[]

  @@map("organizations")
}

model OrgInvite {
  id         String    @id @default(uuid())
  email      String
  orgName    String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("org_invites")
}

model Species {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  animals   Animal[]

  @@map("species")
}

model Animal {
  id                String       @id @default(uuid())
  name              String
  description       String?
  speciesId         String
  species           Species      @relation(fields: [speciesId], references: [id])
  breed             String?
  gender            AnimalGender @default(UNKNOWN)
  ageMonths         Int?
  size              AnimalSize?
  energyLevel       EnergyLevel?
  goodWithKids      Boolean      @default(false)
  goodWithDogs      Boolean      @default(false)
  goodWithCats      Boolean      @default(false)
  goodWithOtherPets Boolean      @default(false)
  specialNeeds      String?
  vaccinated        Boolean      @default(false)
  sterilized        Boolean      @default(false)
  trained           Boolean      @default(false)
  status            AnimalStatus @default(AVAILABLE)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  photos            AnimalPhoto[]
  coverPhotoId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  archivedAt        DateTime?

  @@map("animals")
}

model AnimalPhoto {
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String
  key       String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("animal_photos")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
